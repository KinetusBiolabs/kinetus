{
  "name": "kinetus-biolabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/blur-placeholders.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"lib/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:categories": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed-categories.ts",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types scripts/admin-create.ts",
    "admin:set-credentials": "node --env-file-if-exists=.env --experimental-strip-types scripts/set-admin-credentials.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
