// Kinetus BioLabs — Prisma schema (Phase 2 scaffold)
//
// Source of truth: the Phase 2 reference schema, plus the confirmed corrections:
//   #3  Product specification fields (form … displayOrder) — all nullable, unpopulated
//   #4  ProductVariant.sku is optional (the client price list carries no SKUs)
//   #5  Documentation.batchLot is optional (not every document is batch-specific)
//
// Prices are integers in minor units (cents). Never floats.
//
// Additions beyond the reference schema (reported in the Phase 2 hand-off):
//   - @@index on every foreign-key column (Postgres does not index FKs automatically).
//
// Recommended CHECK constraint (NOT applied — no DATABASE_URL was available, so no
// migration has been generated yet). Add this to the initial migration SQL so a
// Documentation row always points at exactly one of Product / ProductVariant:
//
//   ALTER TABLE "Documentation"
//     ADD CONSTRAINT "Documentation_exactly_one_owner"
//     CHECK (num_nonnulls("productId", "variantId") = 1);
//
// Phase 7A (migration admin_and_catalogue_fields, additive only): variant-level images,
// variant test report links, collection kind and artwork fields, a reserved product
// information sheet link, the discount / volume tier / tax / store setting tables (edited
// in the admin, applied by the cart and checkout since Phase 8), and AdminSession +
// AdminLoginAttempt for server-side sessions and login rate limiting.
//
// Phase 9 (migration order_stock_tracking, additive only): OrderRequest.stockAdjusted, the
// guard that makes stock moves on order status changes idempotent.
//
// Cleanup (migration contact_message_handled, additive only): ContactMessage.handledAt, set
// when the client marks a contact message handled in the admin.
//
// Revision round 1 (migration product_information_sheet, additive only):
// Product.informationSheetAlt, the alt text for the information sheet image, whose URL
// column (informationSheetUrl) was reserved in Phase 7A.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

enum OrderRequestStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  SHIPPED
  CANCELLED
}

enum RedirectEntityType {
  PRODUCT
  COLLECTION
}

/// RANGE: the four navigation ranges (Peptides, Blends, Lab Supplies, Research).
/// CATEGORY: the Shop by Category groupings. A product belongs to one range and to any
/// number of categories.
enum CollectionKind {
  RANGE
  CATEGORY
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?

  // Specification table fields (Phase 2 correction #3). All nullable — no values
  // have been confirmed by the client. Do not populate.
  form              String?
  appearance        String?
  storageConditions String?
  casNumber         String?
  molecularFormula  String?
  molecularWeight   String?
  purityMethod      String?
  featured          Boolean @default(false)
  displayOrder      Int     @default(0)

  // Product information sheet (the client's write-up graphic), uploaded in the admin and
  // opened from the product page's Product Information button. Both are null until the
  // client uploads one; the alt text is required with the image.
  informationSheetUrl String?
  informationSheetAlt String?
  /// Optional plain text shown under the Product Information / Test Reports buttons;
  /// blank lines split paragraphs. Hidden while empty.
  productInfoText     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  collections   ProductCollection[]
  documentation Documentation[]
  orderItems    OrderRequestItem[]
}

model ProductVariant {
  id                  String        @id @default(cuid())
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  label               String
  sku                 String?       @unique
  price               Int
  salePrice           Int?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  stock               Int?
  trackInventory      Boolean       @default(false)
  status              VariantStatus @default(ACTIVE)
  displayOrder        Int           @default(0)
  // Third-party test report link for this product at this strength, set by the client.
  testReportUrl       String?
  testReportUpdatedAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  documentation Documentation[]
  orderItems    OrderRequestItem[]
  images        ProductImage[]

  @@index([productId])
}

model Collection {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  status          CollectionStatus @default(DRAFT)
  displayOrder    Int              @default(0)
  metaTitle       String?
  metaDescription String?
  kind            CollectionKind   @default(RANGE)
  imageUrl        String?
  iconUrl         String?
  subtitle        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  displayOrder Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // A render printed with a strength belongs to that variant. Null = product level
  // (shown for any variant without images of its own). Deleting a variant deletes its
  // renders: a strength-labelled image must never fall back to product level.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model Documentation {
  id        String          @id @default(cuid())
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchLot  String?
  title     String
  fileUrl   String
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

model SlugRedirect {
  id         String             @id @default(cuid())
  fromSlug   String             @unique
  toSlug     String
  entityType RedirectEntityType
  createdAt  DateTime           @default(now())
}

// The single admin account (Phase 7A). Created or reset with `npm run admin:create`.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions AdminSession[]
}

// Server-side admin sessions. The cookie carries the id plus an HMAC signature, so the
// proxy can reject forged cookies without a query; pages and server actions then look
// the row up, which makes logout and password resets revoke access immediately.
model AdminSession {
  id          String    @id
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// Login attempts, for rate limiting the sign-in form by network address and by email.
/// Last order reference number issued per year (KIN-YYYY-NNNN). Incremented inside the
/// order transaction, so concurrent submissions queue on the row and never collide.
model OrderSequence {
  year Int @id
  last Int @default(0)
}

/// A message sent through the /contact form. Every submission is kept with its send
/// status, so nothing is lost before the email provider is configured; the rows also
/// serve as the form's rate-limit record.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ip        String
  /// Set when the email to the client was accepted by the mail provider.
  sentAt    DateTime?
  /// Why the email did not send (no API key, provider error). Null once sent.
  sendError String?
  /// Set when the client marks the message handled in the admin; null while it waits.
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ip, createdAt])
}

/// One row per checkout submission, for rate limiting. Kept apart from AdminLoginAttempt
/// so customer traffic can never lock out the admin, or the reverse.
model CheckoutAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------------------
// Commerce configuration (Phase 7A). Edited in the admin; the cart and checkout have
// applied them since Phase 8 (lib/pricing.ts).
// ---------------------------------------------------------------------------------------

/// Codes are stored exactly as the client wrote them and match case-insensitively at
/// redemption. By default a code never combines with the volume discount; the customer
/// receives whichever is larger. `stacksWithVolume` overrides that per code.
model DiscountCode {
  id               String    @id @default(cuid())
  code             String    @unique
  percentOff       Int
  isActive         Boolean   @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  timesRedeemed    Int       @default(0)
  stacksWithVolume Boolean   @default(false)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model VolumeDiscountTier {
  id          String   @id @default(cuid())
  minQuantity Int
  percentOff  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Combined sales tax per province or territory, in basis points (5% = 500).
model TaxRate {
  id        String   @id @default(cuid())
  province  String   @unique
  label     String
  rateBps   Int
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-row store settings: the fixed primary key allows exactly one row.
/// `taxEnabled` stays false until the business confirms it is registered to collect
/// GST/HST.
model StoreSetting {
  id                         String   @id @default("store")
  taxEnabled                 Boolean  @default(false)
  gstNumber                  String?
  shippingFlatCents          Int      @default(2000)
  /// Admin > Settings; quoted across the site through lib/shipping.ts.
  freeShippingThresholdCents Int      @default(24900)
  localFreeCity              String?  @default("Calgary")
  shipsInternationally       Boolean  @default(false)
  /// Shown to customers on the order confirmation page and in their email.
  etransferEmail             String?  @default("info@kinetusbiolabs.ca")
  etransferInstructions      String?
  /// Payment Instructions on the order confirmation page; each line is hidden while empty.
  payeeName                  String?
  securityQuestion           String?
  securityAnswer             String?
  holdPeriodText             String?
  /// Admin > Settings "Product page text": the intro under the name on every product page
  /// (bold supported). Null uses the default; the research-use line is always appended.
  productIntroText           String?
  /// Where new-order notifications go.
  orderNotifyEmail           String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// An order placed through /checkout (Phase 8). No payment is taken on the site: the client
// arranges Interac e-Transfer by email and moves the status along. Every money field is a
// snapshot computed by lib/pricing.ts at submission, so a later price, discount or tax
// change never alters a placed order.
model OrderRequest {
  id                      String             @id @default(cuid())
  referenceNumber         String             @unique
  status                  OrderRequestStatus @default(NEW)
  customerName            String
  customerEmail           String
  customerPhone           String
  shippingLine1           String
  shippingLine2           String?
  shippingCity            String
  shippingProvince        String
  shippingPostalCode      String
  shippingCountry         String             @default("CA")
  note                    String?
  researchUseAcknowledged Boolean            @default(false)
  ageConfirmed            Boolean            @default(false)
  subtotalCents           Int
  volumeDiscountCents     Int                @default(0)
  codeDiscountCents       Int                @default(0)
  discountCodeUsed        String?
  shippingCents           Int                @default(0)
  taxRateBps              Int                @default(0)
  taxLabel                String?
  taxCents                Int                @default(0)
  totalCents              Int
  trackingNumber          String?
  carrier                 String?
  shippedAt               DateTime?
  paidAt                  DateTime?
  /// True while this order's tracked stock is deducted (Paid or Shipped). Entering Paid or
  /// Shipped deducts only while it is false; New, Awaiting payment or Cancelled restores
  /// only while it is true. Changing a status twice can therefore never deduct twice.
  stockAdjusted           Boolean            @default(false)
  /// Set when both order emails were accepted by the mail provider.
  notificationSentAt      DateTime?
  /// Why the most recent order email did not send (no API key, provider error): the order
  /// emails, or the shipping notification when it starts "Shipping notification: ". Null
  /// once the order emails are sent.
  notificationError       String?
  internalNotes           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  items OrderRequestItem[]
}

// Snapshot fields are the permanent record. productId / variantId are admin
// convenience only (SetNull) so deleting a product never breaks order history.
model OrderRequestItem {
  id                   String          @id @default(cuid())
  orderRequestId       String
  orderRequest         OrderRequest    @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  variantLabelSnapshot String
  skuSnapshot          String
  unitPriceSnapshot    Int
  quantity             Int
  lineTotalCents       Int

  @@index([orderRequestId])
  @@index([productId])
  @@index([variantId])
}
